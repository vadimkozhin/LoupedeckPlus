{
  "targetBundleIdentifier": "com.adobe.LightroomClassicCC7",
  "hotkeys": true,
  "apple_script": true,
  "lightroom_socket": true,
  "customModeButton": {
    "press": {
      "midiMatch": "90 75 40",
      "action": "custom_mode_press"
    },
    "release": {
      "midiMatch": "80 75 40",
      "action": "custom_mode_release"
    }
  },
  "knobs": [
    {
      "comment": "Exposure Knob",
      "default": 0,
      "press": {
        "midiMatch": "80 21 40",
        "socketCommand": "import('LrDevelopController').setValue('Exposure', $DEFAULT)"
      },
      "release": {
        "midiMatch": "80 21 40"
      },
      "plus": {
        "midiMatch": "B0 21 01",
        "socketCommand": "changeAdjustmentValue('Exposure', 0.2, false)"
      },
      "minus": {
        "midiMatch": "B0 21 7F",
        "socketCommand": "changeAdjustmentValue('Exposure', -0.2, false)"
      }
